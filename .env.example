# API Keys
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_api_key

# Optional: Groq Model (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Database connection URL
# When running with Docker Compose, postgres hostname is used:
DATABASE_URL=postgresql://postgres:root@postgres:5432/langgraph_memory
